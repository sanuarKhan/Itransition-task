generator client {
  provider = "prisma-client-js"
  

}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  img       String?
  lang      Language @default(EN)
  theme     Theme    @default(LIGHT)
  role      Role     @default(USER)
  isBlocked Boolean  @default(false)
  templates Template[]
  forms     Form[]
  comments  Comment[]
  likes     Like[]
  accessTo  TemplateAccess[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Template {
  id            String     @id  @default(uuid())
  title         String
  description   String  
  topic         Topic
  thumbnail     String?
  isPublic      Boolean         @default(true)
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  allowedUsers  TemplateAccess[]
  questions     Question[]
  forms         Form[]
  comments      Comment[]
  likes         Like[]
  tags          TagOnTemplate[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("templates")
}

model TemplateAccess {
  id            String     @id  @default(uuid())
  templateId    String
  userId        String
  template      Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@map("template_access")//TODO: need to study this
}

model Tag {
  id            String    @id   @default(uuid())
  name          String    @unique
  templates     TagOnTemplate[]
  createdAt     DateTime  @default(now())

  @@map("tags")
}

model TagOnTemplate {
  templateId    String
  tagId         String
  template      Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag           Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
  @@map("template_tags")
}

model Question {
  id            String    @id  @default(uuid())
  templateId    String
  title         String
  description   String?
  type          QuestionType
  showInTable   Boolean   @default(false)
  order         Int
  isRequired    Boolean   @default(false)
  template      Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers       Answer[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("questions")
}

model Answer {
  id            String   @id  @default(uuid())
  questionId    String
  formId        String
  valueText     String?
  valueInt      Int?
  valueBool     Boolean?
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  form          Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("answers")
}

model Form {
  id            String   @id  @default(uuid())
  templateId    String
  userId        String
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       Answer[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([templateId, userId])
  @@map("forms")
}

model Comment {
  id          String  @id  @default(uuid())
  templateId  String
  userId      String
  content     String
  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("comments")
}

model Like {
  id          String @id @default(uuid())
  templateId  String
  userId      String
  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([templateId, userId])
  @@map("likes")

}

enum Role {
  USER
  ADMIN
}

enum Language {
  EN
  RU
  BN
}

enum Theme {
  LIGHT
  DARK
}

enum Topic {
  EDUCATION
  BUDGETS
  QUIZZ
  REPORTS
  RESEARCH
  SURVEY
  PULL
  OTHERS
}

enum QuestionType {
  SINGLE_LINE
  MULTI_LINE
  INTEGER
  CHECKBOX
}

