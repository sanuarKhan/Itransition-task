{
  "name": "task4-frontend",
  "type": "webpack",
  "compatibility_date": "2025-06-01",
  "main": "src/main.tsx",
  "webpack": {
    "config": "vite.config.ts",
    "dev_config": "vite.config.ts"
  },
  "assets": {
    "directory": "/dist"
  },
  "site": {
    "bucket": "./dist"
  },
  "routes": [
    {
      "pattern": "/api/*",
      "zone_name": "your-api-domain.com"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "VITE_API_URL": "https://your-api-domain.com"
      }
    },
    "development": {
      "vars": {
        "VITE_API_URL": "http://localhost:8080"
      }
    }
  },
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  }
}
